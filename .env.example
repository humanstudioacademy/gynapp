# Copie para .env e preencha. O .env NUNCA vai para o Git.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_DSN=

# Usado só por scripts locais de banco (scripts/db.sh) — não vai para o app
SUPABASE_DB_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
